    "openai": "^5.5.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
