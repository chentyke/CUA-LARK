# OpenAI-compatible VLM endpoint.
# Example for Volcengine Ark:
# VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Xiaomi MiMo example:
# VLM_BASE_URL=https://api.xiaomimimo.com/v1
# VLM_MODEL=mimo-v2.5-pro
# VLM_MODEL=ep-xxxxxxxxxxxxxxxxxxxxx
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

LARK_APP_NAME=Lark
LARK_TEST_CHAT=
LARK_TEST_ATTENDEE=
CUA_MAX_STEPS=25
CUA_MAX_ATTEMPTS=5
CUA_RETRY_DELAY_MS=8000
CUA_SCREENSHOT_DIR=artifacts/runs
